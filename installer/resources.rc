// Resource script for CyberServerTycoonSetup.exe - embeds the game icon.
// The icon is generated by scripts/generate_icon.py before the build.
#include <windows.h>

IDI_APP_ICON ICON "../assets/icon/icon.ico"

// Version info
1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Neon Grid Contributors"
            VALUE "FileDescription",  "Neon Grid: Cyber Server Tycoon - Setup"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "CyberServerTycoonSetup"
            VALUE "OriginalFilename", "CyberServerTycoonSetup.exe"
            VALUE "ProductName",      "Neon Grid: Cyber Server Tycoon"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
